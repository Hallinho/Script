## Query 6: Fact_Table

The main query. Joins PMS_Raw to Project_Master and FX_Rates, computes USD revenue, flags exceptions, and produces the table the data model uses.

```m
let
    Source = PMS_Raw,

    // ─────────────────────────────────────────────────────────────
    // Join to Project Master to get Region, Product, Client, etc.
    // ─────────────────────────────────────────────────────────────
    JoinProject = Table.NestedJoin(
        Source, {"Project_ID"},
        Project_Master, {"Project_ID"},
        "PM", JoinKind.LeftOuter
    ),

    ExpandProject = Table.ExpandTableColumn(
        JoinProject, "PM",
        {"Client", "Region", "Product", "Project_Type", "Internal_3rd_Party", "Region_Product"}
    ),

    // ─────────────────────────────────────────────────────────────
    // Join to FX Rates on Currency_Period
    // ─────────────────────────────────────────────────────────────
    JoinFX = Table.NestedJoin(
        ExpandProject, {"Currency_Period"},
        FX_Rates, {"Currency_Period"},
        "FX", JoinKind.LeftOuter
    ),

    ExpandFX = Table.ExpandTableColumn(
        JoinFX, "FX",
        {"Spot_Rate", "Budget_Rate"}
    ),

    // ─────────────────────────────────────────────────────────────
    // Convert local currency revenue to USD (both reported and CC)
    // ─────────────────────────────────────────────────────────────
    AddRevUSD = Table.AddColumn(ExpandFX, "Est_Total_USD",
        each if [Spot_Rate] = null then null
             else [Estimated_Total] * [Spot_Rate],
        type number),

    AddRevUSD_CC = Table.AddColumn(AddRevUSD, "Est_Total_USD_CC",
        each if [Budget_Rate] = null then null
             else [Estimated_Total] * [Budget_Rate],
        type number),

    // ─────────────────────────────────────────────────────────────
    // Region × Product × Period key for budget join
    // ─────────────────────────────────────────────────────────────
    AddRegionProductPeriod = Table.AddColumn(AddRevUSD_CC, "Region_Product_Period",
        each (try [Region_Product] otherwise "UNMATCHED") & "|" & [Period],
        type text),

    // ─────────────────────────────────────────────────────────────
    // Exception flags — these drive the Exceptions tab
    // ─────────────────────────────────────────────────────────────
    AddMatchFlag = Table.AddColumn(AddRegionProductPeriod, "Match_Flag",
        each
            if [Region] = null then "UNMATCHED PROJECT"
            else if [Spot_Rate] = null then "MISSING FX"
            else if [Billable] = "Y" and ([Rate] = null or [Rate] = 0) then "BILLABLE ZERO RATE"
            else "OK",
        type text),

    // ─────────────────────────────────────────────────────────────
    // Effective rate (calculated for analysis tabs)
    // ─────────────────────────────────────────────────────────────
    AddEffRate = Table.AddColumn(AddMatchFlag, "Effective_Rate_LC",
        each if [Hours] = 0 or [Hours] = null then 0
             else [Estimated_Total] / [Hours],
        type number),

    // Final column ordering
    Reordered = Table.SelectColumns(AddEffRate, {
        "Date", "Period", "Year", "Quarter",
        "Project_ID", "Client", "Region", "Product", "Region_Product", "Region_Product_Period",
        "Project_Type", "Internal_3rd_Party",
        "Task", "Consultant",
        "Hours", "Billable",
        "Rate", "Currency", "Effective_Rate_LC", "Estimated_Total",
        "Spot_Rate", "Budget_Rate",
        "Est_Total_USD", "Est_Total_USD_CC",
        "Match_Flag"
    })
in
    Reordered
```

